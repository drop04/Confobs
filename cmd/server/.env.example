# Copy this file to .env before running the demo:
#   cp .env.example .env
#   go run ./cmd/server

DATABASE_URL=postgres://demo:demo@localhost:5432/tasks
API_KEY=sk-demo-0000000000
PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT=10s
MAX_CONNS=20

# Intentionally left here to demonstrate CheckUnused: this var doesn't match
# any `env` tag on Config, so the server logs a warning about it on startup.
OLD_CACHE_TTL=300
